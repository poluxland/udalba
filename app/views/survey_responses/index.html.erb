<h1>Respuestas Bloque 1</h1>

<table class="table table-bordered table-striped table-sm">
  <thead>
  <tr>
    <th>Usuario</th>
    <th>Fecha</th>
    <th>1. ¿Conoce la misión?</th>
    <th>2. ¿Conoce la visión?</th>
    <th>3. ¿Conoce los valores?</th>
    <th>4. ¿Funciones alineadas a la misión?</th>
    <th>5. ¿Misión considera transformación digital?</th>
    <th>6. ¿Modalidades virtuales coherentes?</th>
    <th>7. ¿Multimodalidad fortalece misión?</th>
    <th>8. ¿Explicitar multimodalidad?</th>
    <th>9. ¿Enfoque apropiado para incorporar virtualidad?</th>
    <th>10. ¿Compromiso con modalidades flexibles?</th>
    <th>11. ¿Virtualidad aporta a inclusión y calidad?</th>
    <th>12. ¿Multimodalidad favorece equidad?</th>
    <th>13. ¿Virtualidad y compromiso social?</th>
    <th>14. ¿Innovación educativa en la visión?</th>
    <th>15. ¿Reflejar compromiso social?</th>
    <th>16. ¿Visión y desarrollo del conocimiento?</th>
    <th>17. ¿Aspectos prioritarios (innovación)?</th>
    <th>18. ¿Aspectos prioritarios (formativos)?</th>
    <th>19. ¿Modalidades multimodales mejoran pertinencia?</th>
    <th>20. ¿Transformación digital y multimodalidad (riesgos)?</th>
    <th>21. ¿Incorporar integridad como valor?</th>
    <th>22. ¿Está alineado con misión y visión?</th>
    <th>23. ¿Cómo la integridad refuerza los valores?</th>
    <th>Acciones</th>
  </tr>
</thead>


  <tbody>
  <% @survey_responses.each do |response| %>
    <tr>
      <td><%= response.user.email_address rescue "N/A" %></td>
      <td><%= l(response.created_at, format: :short) %></td>
      <td><%= response.q1 %></td>
      <td><%= response.q2 %></td>
      <td><%= response.q3 %></td>
      <td><%= response.q4 %></td>
      <td><%= response.q5 %></td>
      <td><%= response.q6 %></td>
      <td><%= response.q7 %></td>
      <td><%= response.q8 %></td>
      <td><%= response.q9 %></td>
      <td><%= response.q17 %></td>
      <td><%= response.q18 %></td>
      <td><%= response.q20 %></td>
      <td><%= response.q19 %></td>
      <td><%= response.q10 %></td>
      <td><%= response.q11 %></td>
      <td><%= response.q12 %></td>
      <td><%= response.q13 %></td>
      <td><%= response.q14 %></td>
      <td><%= response.q15 %></td>
      <td><%= response.q16 %></td>
      <td><%= response.q21 %></td>
      <td><%= response.q22 %></td>
      <td><%= response.q23 %></td>
      <td>
        <%= link_to "Ver", survey_response_path(response), class: "btn btn-sm btn-primary" %>
      </td>
    </tr>
  <% end %>
</tbody>

</table>
